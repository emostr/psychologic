POSTGRES_USER=psychologic
POSTGRES_PASSWORD=psychologic
POSTGRES_DB=psychologic

JWT_SECRET=change-me-in-production

# Публичный адрес платформы. Из него собираются ссылки внутри QR-кодов, и по
# его схеме определяется флаг Secure у cookie сессии: https — ставим, http — нет.
# Если указать https, а открыть платформу по http, Safari выбросит cookie
# и вход перестанет держаться.
PUBLIC_URL=http://localhost:8000

HTTP_PORT=8000
HTTP_BIND=127.0.0.1

# Сколько дней живёт сессия психолога. ПИН спрашивается гораздо чаще.
SESSION_DAYS=90
TOTP_ISSUER=Психолоджик

# Учётка администратора создаётся при первом запуске.
# Оставьте пароль пустым — он сгенерируется и попадёт в журнал контейнера.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=
