POSTGRES_USER=psychologic
POSTGRES_PASSWORD=psychologic
POSTGRES_DB=psychologic

JWT_SECRET=change-me-in-production

# Публичный адрес платформы — из него собираются ссылки внутри QR-кодов.
PUBLIC_URL=http://localhost:8000

HTTP_PORT=8000
HTTP_BIND=127.0.0.1

# Сколько дней живёт сессия психолога. ПИН спрашивается гораздо чаще.
SESSION_DAYS=90
TOTP_ISSUER=Психолоджик

# Учётка администратора создаётся при первом запуске.
# Оставьте пароль пустым — он сгенерируется и попадёт в журнал контейнера.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=
