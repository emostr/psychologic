DATABASE_URL="postgresql://psychologic:psychologic@localhost:5432/psychologic?schema=public"
JWT_SECRET="сгенерируйте: openssl rand -base64 48"
PORT=3000
NODE_ENV=development

# Публичный адрес платформы. Из него собираются ссылки в QR-кодах, и по его
# схеме определяется флаг Secure у cookie сессии: https — ставим, http — нет.
PUBLIC_URL="http://localhost:5173"

# Разрешённые источники для CORS. В проде не нужно: фронт и API на одном домене.
FRONTEND_ORIGIN="http://localhost:5173"

# Сколько живёт сессия психолога (ПИН спрашивается гораздо чаще).
SESSION_DAYS=90

# Имя, которое увидит Google Authenticator.
TOTP_ISSUER="Психолоджик"

# Учётка администратора создаётся при первом запуске.
# Если пароль не задать — он будет сгенерирован и выведен в журнал.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=
